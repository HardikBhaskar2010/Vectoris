# Vectoris Environment Configuration
# Copy this file to .env or .env.local for local development.

# Supabase Configuration
# The desktop client connects using the public Project URL and anonymous key.
# NEVER put the service_role key or database superuser password in this file or any client build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# AI Inference Architecture (Trusted Boundary & Zero Client Secrets)
# Cloud inference API keys (e.g. GROQ_API_KEY) are server-side secrets and must NEVER
# be bundled into client builds or prefixed with VITE_.
#
# Client distributions run completely standalone and offline-capable using the
# built-in local deterministic CAD intelligence engine by default.
#
# Optional: To enable cloud model inference, configure an authenticated backend proxy / edge gateway:
# VITE_INFERENCE_GATEWAY_URL=https://your-backend.example.com/api/ai/v1
# GROQ_API_KEY=gsk_your_groq_api_key_here # Server/Edge environment only
VITE_AI_MODEL=qwen/qwen3.8-27b

