{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vectoris",
  "version": "0.2.1",
  "identifier": "ai.vectoris.workstation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vectoris",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' http://localhost:5173 ws://localhost:5173 ipc:; frame-src 'none'; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Vectoris",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Vectoris AI Inc.",
    "copyright": "Copyright © 2026 Vectoris AI Inc. All rights reserved.",
    "shortDescription": "Vectoris Engineering Desktop Workstation",
    "longDescription": "Vectoris is a local-first desktop engineering workstation for electrical estimating, blueprint takeoff, and evidence-backed quantity estimation."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBM0NBNEIzQzFERDgxRjYKUldUMmdkM0JzNlE4V2xiaXJaZWkyWThFUFVYSDhMV0JROGl3T053V2FJNnFKVWl0L3hkNW4zNVEK",
      "endpoints": [
        "https://github.com/HardikBhaskar2010/Vectoris/releases/latest/download/latest.json"
      ]
    }
  }
}
